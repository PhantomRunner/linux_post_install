#!/bin/bash

clear

LOG_FILE="install_failed.log"
> "$LOG_FILE"

echo "Welcome back, srgwx"

# -------------------------
# Detect package manager
# -------------------------
if command -v apt >/dev/null 2>&1; then
    PM="apt"
elif command -v pacman >/dev/null 2>&1; then
    PM="pacman"
elif command -v dnf >/dev/null 2>&1; then
    PM="dnf"
else
    echo "Unsupported distro"
    exit 1
fi

echo "Detected: $PM"

failed_list=()

# -------------------------
# Package mappings
# -------------------------
case "$PM" in
    apt)
        packages=(
            blender btop docker.io docker-compose fastfetch fish
            kdenlive keepassxc libreoffice obs-studio okular
            qbittorrent steam-installer telegram-desktop unzip
            yt-dlp discord obsidian bruno upscayl
        )
        ;;
    pacman)
        packages=(
            blender btop docker docker-compose fastfetch fish
            kdenlive keepassxc libreoffice-fresh obs-studio okular
            qbittorrent steam telegram-desktop unzip
            yt-dlp discord obsidian bruno upscayl
        )
        ;;
    dnf)
        packages=(
            blender btop docker docker-compose fastfetch fish
            kdenlive keepassxc libreoffice obs-studio okular
            qbittorrent steam telegram-desktop unzip
            yt-dlp discord obsidian bruno upscayl
        )
        ;;
esac

# -------------------------
# Helpers
# -------------------------
is_installed() {
    case "$PM" in
        apt) dpkg -s "$1" >/dev/null 2>&1 ;;
        pacman) pacman -Qi "$1" >/dev/null 2>&1 ;;
        dnf) rpm -q "$1" >/dev/null 2>&1 ;;
    esac
}

install_packages() {
    for pkg in "${packages[@]}"; do
        if is_installed "$pkg"; then
            echo "SKIPPED: $pkg"
            continue
        fi

        echo "Installing $pkg..."

        case "$PM" in
            apt) sudo apt-get install -y "$pkg" ;;
            pacman) sudo pacman -S --noconfirm "$pkg" ;;
            dnf) sudo dnf install -y "$pkg" ;;
        esac

        if [ $? -ne 0 ]; then
            echo "FAILED: $pkg" | tee -a "$LOG_FILE"
            failed_list+=("$pkg")
        fi
    done
}

# -------------------------
# Setup Fish shell
# -------------------------
setup_fish() {
    if ! command -v fish >/dev/null 2>&1; then
        echo "Fish not installed"
        return
    fi

    echo "Configuring Fish shell..."

    FISH_PATH="$(which fish)"

    # Add to /etc/shells if missing
    if ! grep -q "$FISH_PATH" /etc/shells; then
        echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
    fi

    CURRENT_SHELL="$(getent passwd "$USER" | cut -d: -f7)"

    if [ "$CURRENT_SHELL" != "$FISH_PATH" ]; then
        chsh -s "$FISH_PATH"
        echo "Fish set as default shell (log out to apply)"
    else
        echo "Fish already default shell"
    fi
}

# -------------------------
# Setup Fastfetch config
# -------------------------
setup_fastfetch() {
    echo "Setting up Fastfetch config..."

    CONFIG_DIR="$HOME/.config/fastfetch"
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    mkdir -p "$CONFIG_DIR"

    if [ ! -d "$SCRIPT_DIR/fastfetch" ]; then
        echo "Fastfetch config folder not found, skipping"
        return
    fi

    shopt -s nullglob

    for file in "$SCRIPT_DIR/fastfetch/"*; do
        filename="$(basename "$file")"
        target="$CONFIG_DIR/$filename"

        if [ ! -f "$target" ] || ! cmp -s "$file" "$target"; then
            cp "$file" "$target"
            echo "Updated: $filename"
        else
            echo "Unchanged: $filename"
        fi
    done

    # Fix logo name
    if [ -f "$CONFIG_DIR/logo.text" ] && [ ! -f "$CONFIG_DIR/logo.txt" ]; then
        mv "$CONFIG_DIR/logo.text" "$CONFIG_DIR/logo.txt"
    fi

    echo "Fastfetch configured"
}

# -------------------------
# Update system
# -------------------------
echo "Updating system..."

case "$PM" in
    apt) sudo apt-get update ;;
    pacman) sudo pacman -Syu --noconfirm ;;
    dnf) sudo dnf check-update ;;
esac

# -------------------------
# Install packages
# -------------------------
install_packages

# -------------------------
# Docker setup
# -------------------------
setup_docker() {
    if ! command -v docker >/dev/null 2>&1; then
        return
    fi

    echo "Checking Docker..."

    if ! systemctl is-enabled docker >/dev/null 2>&1; then
        sudo systemctl enable docker
    fi

    if ! systemctl is-active docker >/dev/null 2>&1; then
        sudo systemctl start docker
    fi
}

setup_docker

# -------------------------
# Other setups
# -------------------------
setup_fish
setup_fastfetch

# -------------------------
# Result
# -------------------------
echo "-------------------------"

if [ ${#failed_list[@]} -ne 0 ]; then
    echo "Failed packages (install manually):"
    for f in "${failed_list[@]}"; do
        echo "- $f"
    done
else
    echo "All packages installed successfully"
fi
