#!/bin/bash
clear
LOG_FILE="install_failed.log"
> "$LOG_FILE"

echo "Welcome back, srgwx"

# -------------------------
# Detect package manager
# -------------------------
if command -v apt >/dev/null 2>&1; then
    PM="apt"
elif command -v pacman >/dev/null 2>&1; then
    PM="pacman"
elif command -v dnf >/dev/null 2>&1; then
    PM="dnf"
else
    echo "Unsupported distro"
    exit 1
fi

echo "Detected: $PM"

failed_list=()

# -------------------------
# Package mappings
# -------------------------

if [ "$PM" = "apt" ]; then
    packages=(
        blender
        btop
        docker.io
        docker-compose
        fastfetch
        fish
        kdenlive
        keepassxc
        libreoffice
        obs-studio
        okular
        qbittorrent
        steam-installer
        telegram-desktop
        unzip
        yt-dlp
        discord
        obsidian
        bruno
        upscayl
    )

elif [ "$PM" = "pacman" ]; then
    packages=(
        blender
        btop
        docker
        docker-compose
        fastfetch
        fish
        kdenlive
        keepassxc
        libreoffice-fresh
        obs-studio
        okular
        qbittorrent
        steam
        telegram-desktop
        unzip
        yt-dlp
        discord
        obsidian
        bruno
        upscayl
    )

elif [ "$PM" = "dnf" ]; then
    packages=(
        blender
        btop
        docker
        docker-compose
        fastfetch
        fish
        kdenlive
        keepassxc
        libreoffice
        obs-studio
        okular
        qbittorrent
        steam
        telegram-desktop
        unzip
        yt-dlp
        discord
        obsidian
        bruno
        upscayl
    )
fi

# -------------------------
# Install function
# -------------------------

is_installed() {
    case $PM in
        apt)
            dpkg -s "$1" >/dev/null 2>&1
            ;;
        pacman)
            pacman -Qi "$1" >/dev/null 2>&1
            ;;
        dnf)
            rpm -q "$1" >/dev/null 2>&1
            ;;
    esac
}

install_packages() {
    for pkg in "${packages[@]}"; do

        if is_installed "$pkg"; then
            echo "SKIPPED (already installed): $pkg"
            continue
        fi

        echo "Installing $pkg..."

        case $PM in
            apt)
                sudo apt-get install -y "$pkg"
                ;;
            pacman)
                sudo pacman -S --noconfirm "$pkg"
                ;;
            dnf)
                sudo dnf install -y "$pkg"
                ;;
        esac

        if [ $? -ne 0 ]; then
            echo "FAILED: $pkg" | tee -a "$LOG_FILE"
            failed_list+=("$pkg")
        fi
    done
}

# -------------------------
# Setup Fish shell
# -------------------------
setup_fish() {
    if command -v fish >/dev/null 2>&1; then
        echo "Configuring Fish shell..."

        FISH_PATH=$(which fish)

        if ! grep -q "$FISH_PATH" /etc/shells; then
            echo "$FISH_PATH" | sudo tee -a /etc/shells
        fi

        CURRENT_SHELL=$(getent passwd "$USER" | cut -d: -f7)

        if [ "$CURRENT_SHELL" != "$FISH_PATH" ]; then
            chsh -s "$FISH_PATH"
            echo "Fish set as default shell (log out to apply)"
        else
            echo "Fish already default shell"
        fi
    else
        echo "Fish not installed"
    fi
}

# -------------------------
# Setup Fastfetch config
# -------------------------
setup_fastfetch() {
    echo "Setting up Fastfetch config..."

    CONFIG_DIR="$HOME/.config/fastfetch"
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

    mkdir -p "$CONFIG_DIR"
    if [ -d "$SCRIPT_DIR/fastfetch" ]; then
    for file in "$SCRIPT_DIR/fastfetch/"*; do
        filename=$(basename "$file")

        # only copy if file doesn't exist or is different
        if [ ! -f "$CONFIG_DIR/$filename" ] || ! cmp -s "$file" "$CONFIG_DIR/$filename"; then
            cp "$file" "$CONFIG_DIR/"
            echo "Updated: $filename"
        else
            echo "Unchanged: $filename"
        fi
    done
    else
    echo "Fastfetch config folder not found, skipping"
fi

    if [ -f "$CONFIG_DIR/logo.text" ] && [ ! -f "$CONFIG_DIR/logo.txt" ]; then
        mv "$CONFIG_DIR/logo.text" "$CONFIG_DIR/logo.txt"
    fi

    echo "Fastfetch configured"
}

# -------------------------
# Update system
# -------------------------
case $PM in
    apt)
        sudo apt-get update
        ;;
    pacman)
        sudo pacman -Syu --noconfirm
        ;;
    dnf)
        sudo dnf check-update
        ;;
esac

# -------------------------
# Install packages
# -------------------------
install_packages

# -------------------------
# Docker setup
# -------------------------
if command -v docker >/dev/null 2>&1; then
    echo "Checking Docker..."

    if ! systemctl is-enabled docker >/dev/null 2>&1; then
        sudo systemctl enable docker
    fi

    if ! systemctl is-active docker >/dev/null 2>&1; then
        sudo systemctl start docker
    fi
fi

# -------------------------
# Fish setup
# -------------------------
setup_fish

# -------------------------
# Fastfetch setup
# -------------------------
setup_fastfetch

# -------------------------
# Result
# -------------------------
echo "-------------------------"
if [ ${#failed_list[@]} -ne 0 ]; then
    echo "Failed packages (install manually):"
    for f in "${failed_list[@]}"; do
        echo "- $f"
    done
else
    echo "All packages installed successfully"
fi

